# ==========================================
# PrintlabClient Environment Variables Example
# ==========================================

# Backend API endpoint (with /api/v1)
NEXT_PUBLIC_BACKEND_URL=https://printlabapi.devtaijul.com/api/v1

# Image / Media Base URL (without trailing slash)
NEXT_PUBLIC_IMAGE_URL=https://printlabapi.devtaijul.com

# Server Port (optional, default is 4444 for dev or 3000 for server.js)
PORT=4444

